generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String?
  role          String         @default("EMPLOYEE") // ADMIN, MANAGER, EMPLOYEE, NEW_EMPLOYEE
  title         String?
  avatar        String?
  employeeId    String?        @unique
  employee      Employee?      @relation(fields: [employeeId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  activities    Activity[]
  verifications Verification[]
}

model Employee {
  id                     String               @id @default(cuid())
  name                   String
  role                   String
  department             String
  email                  String               @unique
  avatar                 String?
  bio                    String?
  riskLevel              String               @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  knowledgeCoverage      Float                @default(0.0) // 0 to 100 percentage
  criticalKnowledgeCount Int                  @default(0)
  atRiskKnowledgeCount   Int                  @default(0)
  concentrationRatio     Float                @default(0.0)
  isExitModeActive       Boolean              @default(false)
  lifecycleStatus        String               @default("ACTIVE") // ACTIVE, EXIT_PENDING, OFFBOARDED
  managerId              String?
  manager                Employee?            @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  directReports          Employee[]           @relation("EmployeeHierarchy")
  joinedDate             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  user                   User?
  knowledgeItems         KnowledgeItem[]
  createdKnowledgeItems  KnowledgeItem[]      @relation("KnowledgeCreator")
  reviewedKnowledgeItems KnowledgeItem[]      @relation("KnowledgeReviewer")
  projects               EmployeeProject[]
  technologies           EmployeeTechnology[]
  exitSessions           ExitSession[]
  knowledgeGaps          KnowledgeGap[]
  coverageScores         CoverageScore[]
  activities             Activity[]
}

model Project {
  id                   String              @id @default(cuid())
  name                 String
  slug                 String              @unique
  description          String
  department           String
  status               String              @default("ACTIVE") // ACTIVE, MAINTENANCE, DEPRECATED
  riskLevel            String              @default("MEDIUM")
  coverageScore        Float               @default(0.0)
  architectureScore    Float               @default(0.0)
  deploymentScore      Float               @default(0.0)
  troubleshootingScore Float               @default(0.0)
  businessRulesScore   Float               @default(0.0)
  edgeCasesScore       Float               @default(0.0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  employees            EmployeeProject[]
  technologies         ProjectTechnology[]
  knowledgeItems       KnowledgeItem[]
  knowledgeGaps        KnowledgeGap[]
  coverageScores       CoverageScore[]
  activities           Activity[]
}

model EmployeeProject {
  id         String   @id @default(cuid())
  employeeId String
  projectId  String
  role       String?
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([employeeId, projectId])
}

model Technology {
  id          String               @id @default(cuid())
  name        String               @unique
  category    String // Frontend, Backend, Database, Cloud, Cache, DevOps
  version     String?
  description String?
  projects    ProjectTechnology[]
  employees   EmployeeTechnology[]
}

model ProjectTechnology {
  id           String     @id @default(cuid())
  projectId    String
  technologyId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@unique([projectId, technologyId])
}

model EmployeeTechnology {
  id           String     @id @default(cuid())
  employeeId   String
  technologyId String
  proficiency  String     @default("INTERMEDIATE") // NOVICE, INTERMEDIATE, EXPERT
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@unique([employeeId, technologyId])
}

model KnowledgeSource {
  id             String          @id @default(cuid())
  title          String
  type           String // DOCUMENT, MEETING, SLACK, EMAIL, GIT, TICKET, MANUAL, EXIT_INTERVIEW
  fileName       String?
  fileSize       Int?
  mimeType       String?
  fileUrl        String?
  rawText        String
  status         String          @default("PROCESSED") // PENDING, PROCESSING, PROCESSED, FAILED
  confidence     Float           @default(0.9)
  extractedCount Int             @default(0)
  highRiskCount  Int             @default(0)
  processedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  knowledgeItems KnowledgeItem[]
  chunks         KnowledgeChunk[]
}

model KnowledgeChunk {
  id           String               @id @default(cuid())
  sourceId     String
  content      String
  chunkIndex   Int
  metadataJson String?
  source       KnowledgeSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  embeddings   KnowledgeEmbedding[]

  @@index([sourceId])
}

model KnowledgeItem {
  id                  String               @id @default(cuid())
  title               String
  summary             String
  content             String
  originalSourceText  String
  aiInterpretation    String
  whyItMatters        String
  type                String // OPERATIONAL_TIP, DECISION, PROCESS, TROUBLESHOOTING, BUSINESS_RULE, ARCHITECTURE, EDGE_CASE, KNOWN_BUG, SOLUTION, WARNING, BEST_PRACTICE, DEPENDENCY
  risk                String               @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  importance          Int                  @default(7) // 1-10
  confidence          Float                @default(0.85) // 0-1
  status              String               @default("APPROVED") // DRAFT, PENDING_REVIEW, APPROVED, VERIFIED, REJECTED, NEEDS_REVISION, STALE, ARCHIVED
  visibility          String               @default("PUBLIC") // PUBLIC, TEAM, PROJECT, PRIVATE, RESTRICTED
  freshness           String               @default("FRESH") // FRESH, AGING, STALE, UNVERIFIED
  lastVerifiedAt      DateTime?
  verifiedBy          String?
  projectId           String?
  employeeId          String?
  sourceId            String?
  createdByEmployeeId String?
  reviewedByEmployeeId String?
  reviewedAt          DateTime?
  reviewNotes         String?
  version             Int                  @default(1)
  tagsJson            String? // JSON string array
  reasoning           String?
  problemsJson        String? // JSON string array
  solutionsJson       String? // JSON string array
  dependenciesJson    String? // JSON string array
  relatedEntitiesJson String? // JSON string array
  hasConflict         Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  project             Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  employee            Employee?            @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdByEmployee   Employee?            @relation("KnowledgeCreator", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  reviewedByEmployee  Employee?            @relation("KnowledgeReviewer", fields: [reviewedByEmployeeId], references: [id], onDelete: SetNull)
  source              KnowledgeSource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  embeddings          KnowledgeEmbedding[]
  verifications       Verification[]
  conflictA           KnowledgeConflict[]  @relation("ConflictItemA")
  conflictB           KnowledgeConflict[]  @relation("ConflictItemB")
  reviews             KnowledgeReview[]

  @@index([projectId])
  @@index([employeeId])
  @@index([type])
  @@index([risk])
  @@index([status])
  @@index([visibility])
  @@index([createdAt])
}

model KnowledgeReview {
  id              String        @id @default(cuid())
  knowledgeItemId String
  reviewerName    String
  reviewerRole    String?
  action          String // APPROVE, REQUEST_CHANGES, REJECT
  reason          String?
  createdAt       DateTime      @default(now())
  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId])
}

model KnowledgeEmbedding {
  id              String         @id @default(cuid())
  knowledgeItemId String?
  chunkId         String?
  vectorJson      String // Serialized float array
  model           String         @default("text-embedding-3-small")
  dimensions      Int            @default(1536)
  createdAt       DateTime       @default(now())
  knowledgeItem   KnowledgeItem? @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  chunk           KnowledgeChunk? @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId])
  @@index([chunkId])
}

model KnowledgeRelationship {
  id               String   @id @default(cuid())
  sourceEntityId   String
  sourceEntityType String // EMPLOYEE, PROJECT, TECHNOLOGY, PROCESS, PROBLEM, SOLUTION, DOCUMENTATION, KNOWLEDGE, DECISION, SYSTEM, VENDOR
  sourceLabel      String
  targetEntityId   String
  targetEntityType String
  targetLabel      String
  relationshipType String // OWNS, WORKS_ON, USES, DEPLOYS, ENCOUNTERS, SOLVES, DOCUMENTS, DEPENDS_ON, CONFLICTS_WITH, MITIGATES
  weight           Float    @default(1.0)
  description      String?
  metadataJson     String?
  createdAt        DateTime @default(now())

  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@index([relationshipType])
}

model KnowledgeGap {
  id                    String    @id @default(cuid())
  title                 String
  description           String
  category              String // Architecture, Deployment, Troubleshooting, Business Rules, Edge Cases, Dependencies, Operational Tips, Known Problems
  impact                String    @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  status                String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  suggestedAction       String
  suggestedQuestionsJson String?
  projectId             String?
  employeeId            String?
  detectedAt            DateTime  @default(now())
  resolvedAt            DateTime?
  project               Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  employee              Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([employeeId])
  @@index([category])
  @@index([status])
}

model CoverageScore {
  id            String   @id @default(cuid())
  category      String
  score         Float // 0 to 100
  totalExpected Int      @default(10)
  totalCaptured Int      @default(5)
  explanation   String
  projectId     String?
  employeeId    String?
  updatedAt     DateTime @updatedAt
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([employeeId])
  @@index([category])
}

model ExitSession {
  id              String         @id @default(cuid())
  employeeId      String
  status          String         @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  initialCoverage Float          @default(54.0)
  finalCoverage   Float?
  initialGaps     Int            @default(5)
  finalGaps       Int?
  itemsRecovered  Int            @default(0)
  summary         String?
  transcriptJson  String?
  reportPdfUrl    String?
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  questions       ExitQuestion[]
  answers         ExitAnswer[]

  @@index([employeeId])
  @@index([status])
}

model ExitQuestion {
  id               String       @id @default(cuid())
  sessionId        String
  question         String
  category         String
  rationale        String
  priority         String       @default("HIGH") // CRITICAL, HIGH, MEDIUM
  order            Int          @default(1)
  isFollowUp       Boolean      @default(false)
  parentQuestionId String?
  createdAt        DateTime     @default(now())
  session          ExitSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers          ExitAnswer[]

  @@index([sessionId])
}

model ExitAnswer {
  id                  String       @id @default(cuid())
  sessionId           String
  questionId          String
  rawAnswer           String
  audioUrl            String?
  extractedItemsCount Int          @default(0)
  confidence          Float        @default(0.9)
  processedAt         DateTime     @default(now())
  session             ExitSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question            ExitQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([questionId])
}

model KnowledgeConflict {
  id              String        @id @default(cuid())
  itemAId         String
  itemBId         String
  title           String
  description     String
  status          String        @default("DETECTED") // DETECTED, RESOLVED_A, RESOLVED_B, RESOLVED_BOTH_CONTEXTUAL
  resolutionNotes String?
  detectedAt      DateTime      @default(now())
  resolvedAt      DateTime?
  itemA           KnowledgeItem @relation("ConflictItemA", fields: [itemAId], references: [id], onDelete: Cascade)
  itemB           KnowledgeItem @relation("ConflictItemB", fields: [itemBId], references: [id], onDelete: Cascade)

  @@index([itemAId])
  @@index([itemBId])
}

model Verification {
  id              String        @id @default(cuid())
  knowledgeItemId String
  userId          String?
  notes           String?
  verifiedAt      DateTime      @default(now())
  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([knowledgeItemId])
}

model Activity {
  id           String    @id @default(cuid())
  type         String // EXTRACTION, VERIFICATION, GAP_DETECTED, COVERAGE_INCREASE, SOURCE_PROCESSED, CONFLICT_DETECTED, RISK_ALERT, EXIT_SESSION, KNOWLEDGE_SUBMITTED, KNOWLEDGE_APPROVED, KNOWLEDGE_REJECTED
  title        String
  description  String
  metadataJson String?
  userId       String?
  employeeId   String?
  projectId    String?
  createdAt    DateTime  @default(now())
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([createdAt])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String?
  employeeId String?
  type       String // REVIEW_REQUEST, KNOWLEDGE_APPROVED, KNOWLEDGE_REJECTED, CHANGES_REQUESTED, CRITICAL_GAP, STALE_KNOWLEDGE, CONFLICT, LOW_COVERAGE, HIGH_RISK_CONCENTRATION, NEW_AI_QUESTION, DOCUMENT_PROCESSED
  title      String
  message    String
  link       String?
  read       Boolean   @default(false)
  severity   String    @default("INFO") // INFO, WARNING, CRITICAL, SUCCESS
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([employeeId])
  @@index([read])
  @@index([severity])
  @@index([createdAt])
}

model AuditLog {
  id           String    @id @default(cuid())
  userId       String?
  userName     String
  userRole     String
  action       String // LOGIN, LOGOUT, KNOWLEDGE_CREATE, KNOWLEDGE_SUBMIT, KNOWLEDGE_APPROVE, KNOWLEDGE_REJECT, KNOWLEDGE_VERIFY, KNOWLEDGE_DELETE, PERMISSION_CHANGE, ROLE_CHANGE, SOURCE_UPLOAD, AI_QUERY_METADATA, EXIT_MODE_START
  resourceType String? // KNOWLEDGE, EMPLOYEE, PROJECT, SOURCE, SYSTEM
  resourceId   String?
  detailsJson  String? // Safe metadata only, no sensitive prompt content
  ipAddress    String?
  createdAt    DateTime  @default(now())

  @@index([userRole])
  @@index([action])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String   // 6-digit numeric code
  expiresAt DateTime // 10 min expiry
  used      Boolean  @default(false)
  attempts  Int      @default(0) // max 5 attempts
  createdAt DateTime @default(now())

  @@index([email])
}
