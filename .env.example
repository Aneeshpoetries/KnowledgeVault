DATABASE_URL="file:./dev.db" # Or postgresql://user:password@localhost:5432/knowledgevault
OPENAI_API_KEY="" # Enter your OpenAI or compatible API key (optional for demo; fallback heuristic LLM included)
OPENAI_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"
NEXTAUTH_SECRET="knowledgevault-secret-key-demo-2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── MongoDB Atlas (required for auth) ───────────────────────────────────────
# Get this from MongoDB Atlas → Connect → Drivers
MONGODB_URI="mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority"
